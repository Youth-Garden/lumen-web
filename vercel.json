{
  "services": {
    "web": {
      "runtime": "container",
      "root": ".",
      "entrypoint": "Dockerfile.web"
    },
    "admin": {
      "runtime": "container",
      "root": ".",
      "entrypoint": "Dockerfile.admin"
    }
  },
  "rewrites": [
    { "source": "/admin/(.*)", "destination": { "service": "admin" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
